# Salin ke .env lalu isi. File .env tidak masuk git.
# PostgreSQL yang sama dengan yang dipakai Directus.
PGHOST=localhost
PGPORT=5433
PGDATABASE=directus
PGUSER=
PGPASSWORD=

DIRECTUS_URL=
# Opsional: IP untuk dihubungi kalau alamat di DIRECTUS_URL tidak bisa dibuka dari mesin ini.
DIRECTUS_CONNECT_HOST=
DIRECTUS_ADMIN_EMAIL=
DIRECTUS_ADMIN_PASSWORD=

# Kunci tanda tangan access token (acak, panjang)
JWT_SECRET=
# Alamat frontend yang boleh memanggil API, pisahkan dengan koma
FRONTEND_ORIGIN=http://localhost:5173

# Pembaca isi invoice pembelian (PRD 10.1). Kalau kosong, draf pembelian diisi manual.
GROQ_API_KEY=
# Opsional: ganti model vision Groq kalau model bawaan (qwen/qwen3.8-27b) dipensiunkan.
GROQ_MODEL=
